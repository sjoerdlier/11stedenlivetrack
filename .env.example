SUPABASE_URL=
SUPABASE_ANON_KEY=

# Donation link shown in the top bar. Without it, the button renders as a
# visible TODO placeholder instead of failing silently.
NEXT_PUBLIC_DONATION_URL=

# Garmin LiveTrack embed URL, shared by Lowie on race day (29 augustus).
# Without it, the Live-locatie panel shows a placeholder instead of a
# broken iframe.
NEXT_PUBLIC_GARMIN_LIVETRACK_URL=

# 4-digit PIN gating /invoer (the basecamp fallback check-in form). Server-side
# only — deliberately NOT prefixed with NEXT_PUBLIC_, it must never reach the
# browser bundle.
CHECKIN_PIN=
