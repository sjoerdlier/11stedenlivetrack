# Vercel Postgres (Neon) — set automatically once the Storage integration is
# connected in the Vercel dashboard's Storage tab; only needed here for
# local dev (`vercel env pull`). POSTGRES_URL also works if that's the name
# your integration variant sets instead — see src/lib/db.ts.
DATABASE_URL=

# Donation link shown in the top bar. Without it, the button renders as a
# visible TODO placeholder instead of failing silently.
NEXT_PUBLIC_DONATION_URL=

# Optional bootstrap PIN gating /invoer and /beheer. Once someone sets a PIN
# via /beheer it's stored (hashed) in the database and takes priority over
# this — this var only matters until then. Server-side only — deliberately
# NOT prefixed with NEXT_PUBLIC_, it must never reach the browser bundle.
CHECKIN_PIN=

# Garmin LiveTrack links are no longer an env var — set them per route/party
# at /beheer (stored in the database, no redeploy needed).

# Optional: base URL used to resolve absolute og:image/twitter:image URLs
# (see metadataBase in src/app/layout.tsx). Falls back to the known
# production URL if unset, so this is only needed if that domain changes.
NEXT_PUBLIC_SITE_URL=

# Optional: powers /update, a spoken-word live summary aimed at blind/low-
# vision visitors (AI-written from the same live data as the rest of the
# site, read aloud via the browser's own voice). Without it, /update shows
# a friendly "not available right now" message instead of failing — get a
# key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional: upgrades /update's read-aloud voice from the browser's own
# (free, but often robotic) voice to a synthesized Google Cloud
# Text-to-Speech voice — noticeably more human, still free at this
# project's volume. Without it, /update falls back to the browser voice
# exactly as before. Needs a Google Cloud project with the Cloud
# Text-to-Speech API enabled and a billing account attached (required to
# activate the free tier, but this project's usage stays within it) — get a
# key at https://console.cloud.google.com/apis/credentials.
GOOGLE_TTS_API_KEY=
