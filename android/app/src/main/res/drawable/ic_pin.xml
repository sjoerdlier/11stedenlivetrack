<?xml version="1.0" encoding="utf-8"?>
<!-- The one recurring glyph across the whole app (wordmark, hero, empty
     state, permission primer, launcher icon) — same motif as the live
     marker on the website's map. Monochrome by design: every usage sets its
     own android:tint on the ImageView rather than baking a fixed color
     here, so the same file works white-on-blue (hero core) or
     muted-on-transparent (empty state) without duplicating the path. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,21s7,-7.2 7,-12.6A7,7 0,0,0 5,8.4C5,13.8 12,21 12,21z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,8.4m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0"
        android:fillColor="#FFFFFF" />
</vector>
