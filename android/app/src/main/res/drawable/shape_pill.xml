<?xml version="1.0" encoding="utf-8"?>
<!-- The context chip's backdrop — a fixed sunken-surface pill, never
     recolored at runtime (unlike shape_circle.xml, which is). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_sunken" />
    <corners android:radius="24dp" />
</shape>
