<?xml version="1.0" encoding="utf-8"?>
<!-- Style resources aren't merged item-by-item across values/values-night
     the way plain colors/strings are — the whole <style> block is swapped
     wholesale, so this has to repeat every item from values/themes.xml's
     Theme.LiveTrackTracker, not just the one that actually differs
     (windowLightStatusBar: dark background needs light status-bar icons). -->
<resources>
    <style name="Theme.LiveTrackTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
