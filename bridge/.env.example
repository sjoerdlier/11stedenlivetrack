# gps666.net account the bridge logs into to poll Lowie's QXGPS/GF21
# tracker. IP-bound session tokens mean the bridge must log in itself from
# the VM it runs on -- see bridge.py's own header comment for why.
GPS666_ACCOUNT=
GPS666_PASSWORD=

# 11stedenlivetrack's own live-tracking bearer token for (11steden, team) --
# generate/copy this from /beheer (NOT the gps666.net password above).
LIVETRACK_TOKEN=
